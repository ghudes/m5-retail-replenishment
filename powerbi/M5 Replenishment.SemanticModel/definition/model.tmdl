model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["dim_item","dim_store","dim_week","fact_replenishment_weekly","fact_stockout_event","Server","Database"]

ref table dim_item
ref table dim_store
ref table dim_week
ref table fact_replenishment_weekly
ref table fact_stockout_event

ref role CA
ref role TX
ref role WI

ref cultureInfo en-US

