/// One row per item: department and category.
table dim_item
	lineageTag: 509ed245-65c1-4548-9b47-20479331513d

	column item_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 0503480c-0579-4a2a-8c3f-663bcb7fc05f
		summarizeBy: none
		sourceColumn: item_key

	column Item
		dataType: string
		lineageTag: f965c66a-dcf0-4073-8f42-59b758499a01
		summarizeBy: none
		sourceColumn: item_id

	column Department
		dataType: string
		lineageTag: 03eca847-c7c4-47c9-bc87-ef36a023e392
		summarizeBy: none
		sourceColumn: dept_id

	column Category
		dataType: string
		lineageTag: 78f4c9f5-2cfc-4804-8ccd-5aed38a87b88
		summarizeBy: none
		sourceColumn: cat_id

	partition dim_item = m
		mode: import
		source =
				let
				    Source = Sql.Database(Server, Database),
				    dim_item = Source{[Schema = "dbo", Item = "dim_item"]}[Data]
				in
				    dim_item

